{
    "name": "youmad/endurance-route-postgresql",
    "description": "PostgreSQL storage for immutable route revisions and bounded streams",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.4",
        "youmad/endurance-foundation": "^0.1.2",
        "youmad/endurance-geo": "^0.1.0",
        "youmad/endurance-route": "^0.1.0"
    },
    "require-dev": {
        "doctrine/migrations": "^3.9",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Youmad\\Endurance\\RoutePostgresql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youmad\\Endurance\\RoutePostgresql\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@test:integration",
        "test:integration": [
            "@php vendor/bin/doctrine-migrations migrate --configuration=tests/migrations.php --db-configuration=tests/connection.php --no-interaction",
            "phpunit --testsuite integration"
        ],
        "check": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
